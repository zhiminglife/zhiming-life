{
  "name": "zhiming-life-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-api.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "tauri:compile:ci": "tauri build --no-bundle --config src-tauri/tauri.ci.conf.json",
    "tauri:bundle:ci": "tauri bundle --config src-tauri/tauri.ci.conf.json",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run sidecar:build && tauri build --config src-tauri/tauri.release.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.10"
  }
}
